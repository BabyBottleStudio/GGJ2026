  m_TableData:
  - m_Id: 37207855104
    m_Localized: 'I really miss my friend.

      We used to fish together...'
    m_Metadata:
      m_Items: []
  - m_Id: 1034768535552
    m_Localized: A day spend fishing with a friend is a day well spent!
    m_Metadata:
      m_Items: []
  - m_Id: 1873587392512
    m_Localized: ... a bench ... benching in the Forest...
    m_Metadata:
      m_Items: []
  - m_Id: 2327503360000
    m_Localized: Where could he be???
    m_Metadata:
      m_Items: []
  - m_Id: 2636841668608
    m_Localized: ... abandoned game of chess ... weird ...
    m_Metadata:
      m_Items: []
  - m_Id: 3094138245120
    m_Localized: My grandfather taught me how to make a camp fire.
    m_Metadata:
      m_Items: []
  - m_Id: 3531201499136
    m_Localized: Jamming alone is not as fun as jamming with friend.
    m_Metadata:
      m_Items: []
  - m_Id: 3820772052992
    m_Localized: ... (reading noise) ...
    m_Metadata:
      m_Items: []
  - m_Id: 4160225464320
    m_Localized: '... Warmth of a fire is the most beautifull thing in the world.

      Thanks
      Granpa!'
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
