  m_TableData:
  - m_Id: 37207855104
    m_Localized: 'Nedostaje mi moj prijatelj.

      Nekada smo pecali zajedno...'
    m_Metadata:
      m_Items: []
  - m_Id: 1034768535552
    m_Localized: "Dan proveden pecaju\u0107i je dan dobro proveden."
    m_Metadata:
      m_Items: []
  - m_Id: 1873587392512
    m_Localized: "... klupa ... klupuje u \u0161umi ..."
    m_Metadata:
      m_Items: []
  - m_Id: 2327503360000
    m_Localized: Gde bi mogao da bude???
    m_Metadata:
      m_Items: []
  - m_Id: 2636841668608
    m_Localized: "... napu\u0161tena partija \u0161aha ... \u010Dudno..."
    m_Metadata:
      m_Items: []
  - m_Id: 3820772052992
    m_Localized: "... (zvuk \u010Ditanja) ..."
    m_Metadata:
      m_Items: []
  - m_Id: 3531201499136
    m_Localized: Svirati sam nije zabavno kao svirati sa nekim.
    m_Metadata:
      m_Items: []
  - m_Id: 4160225464320
    m_Localized: "Toplota vatre je najlep\u0161i ose\u0107aj na svetu. Hvala Deda!"
    m_Metadata:
      m_Items: []
  - m_Id: 3094138245120
    m_Localized: "Moj deda me je u\u010Dio kako se lo\u017Ei vatra."
    m_Metadata:
      m_Items: []
